# Copy to .env and fill in. .env is git-ignored.

# Claude (Anthropic API) for the de-identification sheet and rewrites.
ANTHROPIC_API_KEY=
DEID_REWRITE_MODEL=claude-sonnet-5-5
# Server-side refusal fallback: "default" or "off".
DEID_CLAUDE_FALLBACKS=default

# Judge backend: "jev" (TypeSafe decision model) or "claude" (Claude Haiku fallback).
DEID_JUDGE_BACKEND=jev
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-1.13.0
DEID_JUDGE_CLAUDE_MODEL=claude-haiku-5-5

# Pipeline shape.
DEID_WINDOW_TURNS=8
DEID_LINEUP_SEEDS=1,2,3
DEID_WORKERS=4
